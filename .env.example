# Copy to .env.local. All values are optional for local development.

# Signs the session cookie. Required for any shared deployment.
AUTH_SECRET=

# Turns on the plain-language summary in the AI caution panel (Claude API).
# Leave empty to show the retrieval-based caution cards only.
ANTHROPIC_API_KEY=
# CAUTION_MODEL=claude-opus-5-5

# Folder for the JSON database and uploaded files. Default: ./.data
# MEDIREACH_DATA_DIR=
